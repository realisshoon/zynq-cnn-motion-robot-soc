        <mxCell id="n43" value="&lt;div style=&quot;font-size:21px;font-weight:bold;line-height:145%&quot;&gt;JointCommand&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:145%;margin-top:7px&quot;&gt;5개 로봇 관절각&lt;br&gt;+ 원래 gripper_norm&lt;br&gt;+ valid&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Malgun Gothic;fontColor=#087F6B;fillColor=#CCEFE4;strokeColor=#087F6B;strokeWidth=1.5;spacing=8;" vertex="1" parent="1">
