        <mxCell id="n39" value="&lt;div style=&quot;font-size:21px;font-weight:bold;line-height:145%&quot;&gt;로봇 좌표 보정&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:145%;margin-top:7px&quot;&gt;5개 각도 × 배율 × 방향&lt;br&gt;+ 영점 오프셋&lt;br&gt;관절별 min / max 제한&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Malgun Gothic;fontColor=#087F6B;fillColor=#FFFFFF;strokeColor=#087F6B;strokeWidth=1.5;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="655" y="995" width="245" height="135" />
        </mxCell>
        <mxCell id="n40" value="&lt;div style=&quot;font-size:21px;font-weight:bold;line-height:145%&quot;&gt;목표 자세 안전검사&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:145%;margin-top:7px&quot;&gt;2D 정기구학으로 위치 계산&lt;br&gt;자기·바닥 충돌 / 특이점 근접&lt;br&gt;최대 도달 경계 검사&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Malgun Gothic;fontColor=#087F6B;fillColor=#FFFFFF;strokeColor=#087F6B;strokeWidth=1.5;spacing=8;" vertex="1" parent="1">
