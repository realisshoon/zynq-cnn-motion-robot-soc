        <mxCell id="n74" value="&lt;div style=&quot;font-size:21px;font-weight:bold;line-height:145%&quot;&gt;통합 동작 검증&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:145%;margin-top:7px&quot;&gt;명령과 실제 동작 일치 확인&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Malgun Gothic;fontColor=#172B4D;fillColor=#FFFFFF;strokeColor=#172B4D;strokeWidth=1.5;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1920" y="1740" width="285" height="90" />
