        <mxCell id="n22" value="&lt;div style=&quot;font-size:21px;font-weight:bold;line-height:145%&quot;&gt;HumanJointTarget → JointCommand&lt;/div&gt;&lt;div style=&quot;font-size:18px;line-height:145%;margin-top:7px&quot;&gt;로봇의 5개 관절각 + 원래 그리퍼 값&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Malgun Gothic;fontColor=#087F6B;fillColor=#EAF7F3;strokeColor=#087F6B;strokeWidth=1.5;spacing=8;" vertex="1" parent="1">
