        <mxCell id="n11" value="&lt;div style=&quot;font-size:28px;font-weight:bold;line-height:145%&quot;&gt;Agent 3&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontFamily=Malgun Gothic;fontColor=#C66A13;fillColor=none;strokeColor=none;strokeWidth=1.5;spacing=8;" vertex="1" parent="1">
