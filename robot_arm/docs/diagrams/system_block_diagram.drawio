        <mxCell id="n8" value="&lt;div style=&quot;font-size:25px;font-weight:bold;line-height:145%&quot;&gt;AGENT 3   |   실행 모드 선택 → 서보 변환 → 하드웨어 출력&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontFamily=Malgun Gothic;fontColor=#C66A13;fillColor=none;strokeColor=none;strokeWidth=1.5;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="1475" width="2140" height="45" />
        </mxCell>
        <mxCell id="n9" value="&lt;div style=&quot;font-size:21px;font-weight:bold;line-height:145%&quot;&gt;2D 인식 결과&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:145%;margin-top:7px&quot;&gt;PoseNet / Color Detection&lt;br&gt;HumanPose2D · frame_id&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Malgun Gothic;fontColor=#2563EB;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=1.5;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="75" y="265" width="240" height="125" />
        </mxCell>
        <mxCell id="n10" value="&lt;div style=&quot;font-size:21px;font-weight:bold;line-height:145%&quot;&gt;프레임·제어 팔 관리&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:145%;margin-top:7px&quot;&gt;같은 frame_id는 재계산 생략&lt;br&gt;제어 팔 변경 시 이전 상태 초기화&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Malgun Gothic;fontColor=#2563EB;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=1.5;spacing=8;" vertex="1" parent="1">
