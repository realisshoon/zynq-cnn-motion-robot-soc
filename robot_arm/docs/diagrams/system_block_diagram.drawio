        <mxCell id="n21" value="&lt;div style=&quot;font-size:21px;font-weight:bold;line-height:145%&quot;&gt;HumanPose2D → HumanJointTarget&lt;/div&gt;&lt;div style=&quot;font-size:18px;line-height:145%;margin-top:7px&quot;&gt;2D 좌표 → 사람의 5개 관절각 + 그리퍼&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Malgun Gothic;fontColor=#2563EB;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=1.5;spacing=8;" vertex="1" parent="1">
