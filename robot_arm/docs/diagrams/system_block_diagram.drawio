        </mxCell>
        <mxCell id="n37" value="&lt;div style=&quot;font-size:21px;font-weight:bold;line-height:145%&quot;&gt;입력 유효성 검증&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:145%;margin-top:7px&quot;&gt;valid · NaN / Inf 확인&lt;br&gt;유효한 입력만 상태 갱신&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Malgun Gothic;fontColor=#087F6B;fillColor=#FFFFFF;strokeColor=#087F6B;strokeWidth=1.5;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="75" y="995" width="245" height="135" />
