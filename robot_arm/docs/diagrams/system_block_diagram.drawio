        <mxCell id="n38" value="&lt;div style=&quot;font-size:21px;font-weight:bold;line-height:145%&quot;&gt;각도 경계 연속화&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:145%;margin-top:7px&quot;&gt;Base / Wrist Pitch / Roll&lt;br&gt;179° → −179°를 +2°로 해석&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Malgun Gothic;fontColor=#087F6B;fillColor=#FFFFFF;strokeColor=#087F6B;strokeWidth=1.5;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="365" y="995" width="245" height="135" />
