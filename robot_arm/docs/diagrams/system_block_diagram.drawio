        <mxCell id="n6" value="&lt;div style=&quot;font-size:25px;font-weight:bold;line-height:145%&quot;&gt;AGENT 1   |   영상 좌표를 사람 관절 목표로 변환&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontFamily=Malgun Gothic;fontColor=#2563EB;fillColor=none;strokeColor=none;strokeWidth=1.5;spacing=8;" vertex="1" parent="1">
