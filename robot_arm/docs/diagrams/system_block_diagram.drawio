        <mxCell id="n24" value="&lt;div style=&quot;font-size:24px;font-weight:bold;line-height:145%&quot;&gt;통합 동작 검증&lt;/div&gt;&lt;div style=&quot;font-size:20px;line-height:145%;margin-top:7px&quot;&gt;실제 로봇팔 동작과 명령 비교&lt;br&gt;통합 검증 결과&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Malgun Gothic;fontColor=#172B4D;fillColor=#FFFFFF;strokeColor=#172B4D;strokeWidth=1.5;spacing=8;" vertex="1" parent="1">
