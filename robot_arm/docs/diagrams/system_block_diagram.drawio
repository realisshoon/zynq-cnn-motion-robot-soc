        <mxCell id="e25label" value="관찰·검증" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Malgun Gothic;fontSize=16;fontColor=#65768B;fillColor=#F8FAFC;strokeColor=none;" vertex="1" parent="1">
